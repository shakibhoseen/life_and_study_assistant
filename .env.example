# ==============================================================================
# Life & Study Assistant - Environment Variables
# ==============================================================================

# 1. Google Cloud OAuth Web Client ID (Required for Direct In-App Google Drive Sync)
# ------------------------------------------------------------------------------
# Go to: https://console.cloud.google.com/
# Package Name: com.shakib.life_and_study_assistant
# SHA-1: 8F:33:EA:CD:51:4E:CB:FE:57:C6:17:09:9E:56:B4:04:5D:F4:EF:0C
# Create Credentials -> OAuth client ID -> Web application
# Paste the generated Web Client ID here:
GOOGLE_WEB_CLIENT_ID=

# 2. Google Gemini API Key (Optional: for AI study plans and mistake explanations)
# ------------------------------------------------------------------------------
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
