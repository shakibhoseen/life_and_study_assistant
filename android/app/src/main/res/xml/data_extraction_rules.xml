<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above, for both the cloud backup and a device-to-device
  transfer. Same reasoning as backup_rules.xml: the preferences file holds the
  Gemini API key in plain text, so it travels nowhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
